CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_mi-router-3g=y
CONFIG_DEVEL=y
CONFIG_CCACHE=y
CONFIG_TARGET_OPTIONS=y
CONFIG_TARGET_OPTIMIZATION="-Os -pipe -mno-branch-likely -mips32r2 -mtune=24kc"
CONFIG_SOFT_FLOAT=y
# CONFIG_USE_MIPS16 is not set
CONFIG_USE_GC_SECTIONS=y
CONFIG_KERNEL_PERF_EVENTS=y
CONFIG_ZLIB_OPTIMIZE_SPEED=y
CONFIG_ZSTD_OPTIMIZE_O3=y
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-ng is not set
# CONFIG_PACKAGE_luci-app-rclone_INCLUDE_rclone-webui is not set
# CONFIG_PACKAGE_ipv6helper is not set
CONFIG_PACKAGE_luci-app-eqos=y
CONFIG_PACKAGE_luci-app-turboacc=y
# CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_OFFLOADING
CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_DNSFORWARDER=y
CONFIG_PACKAGE_luci-app-turboacc-mtk_INCLUDE_DNSPROXY=y
